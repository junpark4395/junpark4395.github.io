---
import type { Page } from 'astro';
import {
  allTags,
  excerpt,
  formatDate,
  getPosts,
  postPath,
  tagPath,
  type Post,
} from '../utils/posts';
import { slugify } from '../utils/slugify';

interface Props {
  page: Page<Post>;
  /** Slug of the tag being filtered on, if any. */
  tag?: string;
}

const { page, tag } = Astro.props;
const tags = allTags(await getPosts());
---

{
  tags.length > 0 && (
    <nav class="tag-filter" aria-label="Tags">
      <a href="/" aria-current={tag ? undefined : 'page'}>
        all
      </a>
      {tags.map((t) => (
        <a href={tagPath(t)} aria-current={slugify(t) === tag ? 'page' : undefined}>
          {t}
        </a>
      ))}
    </nav>
  )
}

<ul class="posts">
  {
    page.data.map((post) => (
      <li>
        <time class="post-date" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <a class="post-link" href={postPath(post)}>
          {post.data.title}
        </a>
        <p class="excerpt">{excerpt(post)}</p>
      </li>
    ))
  }
</ul>

{
  page.lastPage > 1 && (
    <nav class="pager" aria-label="Pages">
      {page.url.prev ? <a href={page.url.prev}>← Newer posts</a> : <span />}
      <span class="pager-count">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? <a href={page.url.next}>Older posts →</a> : <span />}
    </nav>
  )
}
